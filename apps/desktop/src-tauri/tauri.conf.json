{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "agenda",
  "version": "0.1.0",
  "identifier": "com.agenda.dev",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "yarn --cwd ../frontend dev",
    "beforeBuildCommand": "yarn --cwd ../frontend build"
  },
  "app": {
    "windows": [
      {
        "title": "agenda",
        "width": 960,
        "height": 1440,
        "maximized": false,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "visible": true,
        "skipTaskbar": false
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://tauri.localhost",
        "style-src": "'unsafe-inline' 'self'",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost http://tauri.localhost blob: data:",
        "script-src": "'self' 'unsafe-eval'",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
